@page "/404"
@layout MainLayout

<PageTitle>Página no encontrada | Airport</PageTitle>

<section class="not-found">
    <span class="material-symbols-rounded" aria-hidden="true">wrong_location</span>
    <p class="eyebrow">Error 404</p>
    <h1>Esta ruta no está en nuestro itinerario</h1>
    <p>La página que buscas pudo cambiar de puerta o ya no está disponible.</p>
    <a class="primary-button" href="/">
        <span class="material-symbols-rounded" aria-hidden="true">flight_takeoff</span>
        Volver a vuelos
    </a>
</section>
