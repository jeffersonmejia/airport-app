@using Airport.Features.Auth.Presentation.Web.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession AuthSession

<div class="app-shell">
    <aside class="side-nav @(menuOpen ? "side-nav--open" : null)" aria-label="Navegación principal">
        <a class="brand" href="/" aria-label="Airport, inicio">
            <span class="brand__mark material-symbols-rounded" aria-hidden="true">flight_takeoff</span>
            <span>
                <strong>Airport</strong>
                <small>Viaja simple</small>
            </span>
        </a>

        <NavMenu />

        <div class="side-nav__footer">
            <span class="material-symbols-rounded" aria-hidden="true">favorite</span>
            <span>Hecho para volar ligero</span>
        </div>
    </aside>

    @if (menuOpen)
    {
        <button class="nav-backdrop" aria-label="Cerrar navegación" @onclick="ToggleMenu"></button>
    }

    <div class="app-content">
        <header class="top-app-bar">
            <button class="icon-button menu-button" type="button" aria-label="Abrir navegación" @onclick="ToggleMenu">
                <span class="material-symbols-rounded" aria-hidden="true">menu</span>
            </button>
            <div class="top-app-bar__title">
                <span>Compra tu próximo boleto</span>
                <small>Busca vuelos, elige tu tarifa y viaja</small>
            </div>
            <a class="avatar" href="/login" aria-label="@(AuthSession.IsAuthenticated ? "Ver sesión de usuario" : "Iniciar sesión")">
                @if (AuthSession.IsAuthenticated)
                {
                    @Initials
                }
                else
                {
                    <span class="material-symbols-rounded" aria-hidden="true">person</span>
                }
            </a>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool menuOpen;

    private string Initials
    {
        get
        {
            var username = AuthSession.Current?.Username ?? string.Empty;
            return username.Length switch
            {
                0 => "?",
                1 => username.ToUpperInvariant(),
                _ => username[..2].ToUpperInvariant()
            };
        }
    }

    protected override void OnInitialized() => AuthSession.Changed += OnSessionChanged;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthSession.Changed -= OnSessionChanged;
}
