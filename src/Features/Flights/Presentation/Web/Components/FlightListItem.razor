@using Airport.Features.Flights.Presentation.Web.Models

<button class="flight-list-item" type="button" @onclick="() => OnSelect.InvokeAsync(Flight.Id)">
    <div class="flight-list-item__icon">
        <span class="material-symbols-rounded" aria-hidden="true">flight</span>
    </div>
    <div>
        <small>Vuelo</small>
        <strong>@Flight.Number</strong>
    </div>
    <div>
        <small>Ruta</small>
        <strong>@Flight.OriginCode → @Flight.DestinationCode</strong>
    </div>
    <div>
        <small>Salida</small>
        <strong>@Flight.Departure.ToLocalTime().ToString("dd MMM · HH:mm")</strong>
    </div>
    <span class="flight-list-item__id">Desde $@Flight.FromPrice.ToString("0.00")</span>
</button>

@code {
    [Parameter, EditorRequired]
    public FlightViewModel Flight { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<int> OnSelect { get; set; }
}
