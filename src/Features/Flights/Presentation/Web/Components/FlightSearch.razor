@using Airport.Features.Flights.Presentation.Web.Models
@using Airport.Features.Flights.Presentation.Web.Services
@inject FlightsClient FlightsClient

<form class="search-card search-card--filters" @onsubmit="SubmitAsync" @onsubmit:preventDefault aria-label="Filtrar vuelos disponibles">
    <div class="search-grid">
        <label class="search-control">
            <span>Aeropuerto de origen</span>
            <select @bind="originAirportId" @bind:after="LoadDestinationsAsync"
                    disabled="@(IsLoading || isOriginsLoading || isDestinationsLoading)">
                <option value="">@(isOriginsLoading ? "Cargando orígenes…" : "Todos los orígenes")</option>
                @foreach (var airport in origins)
                {
                    <option value="@airport.Id">@airport.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Aeropuerto de destino</span>
            <select @bind="destinationAirportId"
                    disabled="@(IsLoading || isDestinationsLoading || originAirportId is null)">
                <option value="">@(DestinationPlaceholder)</option>
                @foreach (var airport in destinations)
                {
                    <option value="@airport.Id">@airport.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Fecha de salida</span>
            <input type="date" @bind="departureDate" disabled="@IsLoading" />
        </label>

        <label class="search-control">
            <span>Número de vuelo</span>
            <input maxlength="8" placeholder="Ej. AE007" autocomplete="off"
                   @bind="number" disabled="@IsLoading" />
        </label>

        <label class="search-control">
            <span>ID de aerolínea</span>
            <input type="number" min="1" inputmode="numeric" placeholder="Ej. 2"
                   @bind="airlineId" disabled="@IsLoading" />
        </label>

        <label class="search-control">
            <span>ID de avión</span>
            <input type="number" min="1" inputmode="numeric" placeholder="Ej. 4"
                   @bind="airplaneId" disabled="@IsLoading" />
        </label>

        <label class="search-control">
            <span>Ordenar por</span>
            <select @bind="sortBy" disabled="@IsLoading">
                <option value="departure">Hora de salida</option>
                <option value="arrival">Hora de llegada</option>
                <option value="number">Número de vuelo</option>
            </select>
        </label>

        <label class="search-control search-control--check">
            <input type="checkbox" @bind="descending" disabled="@IsLoading" />
            <span>Orden descendente</span>
        </label>
    </div>

    @if (validationMessage is not null)
    {
        <p class="search-validation" role="alert">@validationMessage</p>
    }

    <div class="search-actions">
        <button class="text-button" type="button" disabled="@IsLoading" @onclick="ClearAsync">
            <span class="material-symbols-rounded" aria-hidden="true">filter_alt_off</span>
            Limpiar
        </button>
        <button class="primary-button search-submit" type="submit" disabled="@IsLoading">
            <span class="material-symbols-rounded" aria-hidden="true">filter_alt</span>
            <span>@(IsLoading ? "Filtrando…" : "Aplicar filtros")</span>
        </button>
    </div>
</form>

@code {
    private int? originAirportId;
    private int? destinationAirportId;
    private DateOnly? departureDate;
    private string? number;
    private short? airlineId;
    private int? airplaneId;
    private string sortBy = "departure";
    private bool descending;
    private bool isOriginsLoading;
    private bool isDestinationsLoading;
    private string? validationMessage;
    private IReadOnlyCollection<AirportViewModel> origins = [];
    private IReadOnlyCollection<AirportViewModel> destinations = [];

    private string DestinationPlaceholder => isDestinationsLoading
        ? "Cargando destinos…"
        : originAirportId is null ? "Selecciona primero un origen" : "Todos los destinos";

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<FlightSearchInput> OnSearch { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isOriginsLoading = true;
        try
        {
            origins = await FlightsClient.ListAirportsAsync(null, CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar los aeropuertos disponibles.";
        }
        finally
        {
            isOriginsLoading = false;
        }
    }

    private Task SubmitAsync()
    {
        validationMessage = null;
        if (originAirportId is not null && originAirportId == destinationAirportId)
        {
            validationMessage = "El aeropuerto de destino debe ser diferente del origen.";
            return Task.CompletedTask;
        }

        return OnSearch.InvokeAsync(new FlightSearchInput(
            originAirportId,
            destinationAirportId,
            departureDate,
            number?.Trim(),
            airlineId,
            airplaneId,
            sortBy,
            descending));
    }

    private Task ClearAsync()
    {
        originAirportId = null;
        destinationAirportId = null;
        destinations = [];
        departureDate = null;
        number = null;
        airlineId = null;
        airplaneId = null;
        sortBy = "departure";
        descending = false;
        validationMessage = null;

        return OnSearch.InvokeAsync(new FlightSearchInput(
            null, null, null, null, null, null, "departure", false));
    }

    private async Task LoadDestinationsAsync()
    {
        destinationAirportId = null;
        destinations = [];
        validationMessage = null;

        if (originAirportId is null)
        {
            return;
        }

        isDestinationsLoading = true;
        try
        {
            destinations = await FlightsClient.ListAirportsAsync(
                originAirportId,
                CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar los destinos para ese origen.";
        }
        finally
        {
            isDestinationsLoading = false;
        }
    }
}
