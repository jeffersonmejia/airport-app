@using Airport.Features.Flights.Presentation.Web.Models
@using Airport.Features.Flights.Presentation.Web.Services
@inject FlightsClient FlightsClient

<form class="search-card search-card--filters" @onsubmit="SubmitAsync" @onsubmit:preventDefault aria-label="Filtrar vuelos disponibles">
    <div class="search-grid">
        <label class="search-control">
            <span>Aeropuerto de origen</span>
            <select @bind="originAirportId" @bind:after="LoadDestinationsAsync"
                    disabled="@(IsLoading || isOriginsLoading || isDestinationsLoading || isFlightNumbersLoading)">
                <option value="">@(isOriginsLoading ? "Cargando orígenes…" : "Todos los orígenes")</option>
                @foreach (var airport in origins)
                {
                    <option value="@airport.Id">@airport.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Aeropuerto de destino</span>
            <select @bind="destinationAirportId" @bind:after="LoadFlightNumbersAsync"
                    disabled="@(IsLoading || isDestinationsLoading || isFlightNumbersLoading || originAirportId is null)">
                <option value="">@(DestinationPlaceholder)</option>
                @foreach (var airport in destinations)
                {
                    <option value="@airport.Id">@airport.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Fecha de salida</span>
            <input type="date" @bind="departureDate" @bind:after="LoadFlightNumbersAsync"
                   disabled="@(IsLoading || isFlightNumbersLoading)" />
        </label>

        <label class="search-control">
            <span>Número de vuelo</span>
            <select @bind="number"
                    disabled="@(IsLoading || isFlightNumbersLoading || !HasSelectedRoute)">
                <option value="">@FlightNumberPlaceholder</option>
                @foreach (var flightNumber in flightNumbers)
                {
                    <option value="@flightNumber">@flightNumber</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Aerolínea</span>
            <select @bind="airlineId" @bind:after="LoadAirplanesAsync"
                    disabled="@(IsLoading || isAirlinesLoading || isAirplanesLoading || isFlightNumbersLoading)">
                <option value="">@(isAirlinesLoading ? "Cargando aerolíneas…" : "Todas las aerolíneas")</option>
                @foreach (var airline in airlines)
                {
                    <option value="@airline.Id">@airline.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Avión</span>
            <select @bind="airplaneId" @bind:after="LoadFlightNumbersAsync"
                    disabled="@(IsLoading || isAirplanesLoading || isFlightNumbersLoading || airlineId is null)">
                <option value="">@AirplanePlaceholder</option>
                @foreach (var airplane in airplanes)
                {
                    <option value="@airplane.Id">@airplane.Label</option>
                }
            </select>
        </label>

        <label class="search-control">
            <span>Ordenar por</span>
            <select @bind="sortBy" disabled="@IsLoading">
                <option value="departure">Hora de salida</option>
                <option value="arrival">Hora de llegada</option>
                <option value="number">Número de vuelo</option>
            </select>
        </label>

        <label class="search-control search-control--check">
            <input type="checkbox" @bind="descending" disabled="@IsLoading" />
            <span>Orden descendente</span>
        </label>
    </div>

    @if (validationMessage is not null)
    {
        <p class="search-validation" role="alert">@validationMessage</p>
    }

    <div class="search-actions">
        <button class="text-button" type="button" disabled="@IsLoading" @onclick="ClearAsync">
            <span class="material-symbols-rounded" aria-hidden="true">filter_alt_off</span>
            Limpiar
        </button>
        <button class="primary-button search-submit" type="submit" disabled="@IsLoading">
            <span class="material-symbols-rounded" aria-hidden="true">filter_alt</span>
            <span>@(IsLoading ? "Filtrando…" : "Aplicar filtros")</span>
        </button>
    </div>
</form>

@code {
    private int? originAirportId;
    private int? destinationAirportId;
    private DateOnly? departureDate;
    private string? number;
    private short? airlineId;
    private int? airplaneId;
    private string sortBy = "departure";
    private bool descending;
    private bool isOriginsLoading;
    private bool isDestinationsLoading;
    private bool isAirlinesLoading;
    private bool isAirplanesLoading;
    private bool isFlightNumbersLoading;
    private string? validationMessage;
    private IReadOnlyCollection<AirportViewModel> origins = [];
    private IReadOnlyCollection<AirportViewModel> destinations = [];
    private IReadOnlyCollection<AirlineOptionViewModel> airlines = [];
    private IReadOnlyCollection<AirplaneOptionViewModel> airplanes = [];
    private IReadOnlyCollection<string> flightNumbers = [];

    private bool HasSelectedRoute => originAirportId is not null && destinationAirportId is not null;

    private string DestinationPlaceholder => isDestinationsLoading
        ? "Cargando destinos…"
        : originAirportId is null ? "Selecciona primero un origen" : "Todos los destinos";

    private string AirplanePlaceholder => isAirplanesLoading
        ? "Cargando aviones…"
        : airlineId is null ? "Selecciona primero una aerolínea" : "Todos los aviones";

    private string FlightNumberPlaceholder => isFlightNumbersLoading
        ? "Cargando vuelos…"
        : !HasSelectedRoute
            ? "Selecciona primero origen y destino"
            : flightNumbers.Count == 0 ? "No hay vuelos compatibles" : "Todos los vuelos";

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<FlightSearchInput> OnSearch { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isOriginsLoading = true;
        isAirlinesLoading = true;
        try
        {
            var originsTask = FlightsClient.ListAirportsAsync(null, CancellationToken.None);
            var airlinesTask = FlightsClient.ListAirlinesAsync(CancellationToken.None);
            await Task.WhenAll(originsTask, airlinesTask);
            origins = await originsTask;
            airlines = await airlinesTask;
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar las opciones disponibles.";
        }
        finally
        {
            isOriginsLoading = false;
            isAirlinesLoading = false;
        }
    }

    private Task SubmitAsync()
    {
        validationMessage = null;
        if (originAirportId is not null && originAirportId == destinationAirportId)
        {
            validationMessage = "El aeropuerto de destino debe ser diferente del origen.";
            return Task.CompletedTask;
        }

        return OnSearch.InvokeAsync(new FlightSearchInput(
            originAirportId,
            destinationAirportId,
            departureDate,
            number?.Trim(),
            airlineId,
            airplaneId,
            sortBy,
            descending));
    }

    private Task ClearAsync()
    {
        originAirportId = null;
        destinationAirportId = null;
        destinations = [];
        number = null;
        flightNumbers = [];
        departureDate = null;
        airlineId = null;
        airplaneId = null;
        airplanes = [];
        sortBy = "departure";
        descending = false;
        validationMessage = null;

        return OnSearch.InvokeAsync(new FlightSearchInput(
            null, null, null, null, null, null, "departure", false));
    }

    private async Task LoadDestinationsAsync()
    {
        destinationAirportId = null;
        destinations = [];
        number = null;
        flightNumbers = [];
        validationMessage = null;

        if (originAirportId is null)
        {
            return;
        }

        isDestinationsLoading = true;
        try
        {
            destinations = await FlightsClient.ListAirportsAsync(
                originAirportId,
                CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar los destinos para ese origen.";
        }
        finally
        {
            isDestinationsLoading = false;
        }
    }

    private async Task LoadAirplanesAsync()
    {
        airplaneId = null;
        airplanes = [];
        validationMessage = null;

        if (airlineId is null)
        {
            await LoadFlightNumbersAsync();
            return;
        }

        isAirplanesLoading = true;
        try
        {
            airplanes = await FlightsClient.ListAirplanesAsync(
                airlineId.Value,
                CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar los aviones para esa aerolínea.";
        }
        finally
        {
            isAirplanesLoading = false;
        }

        await LoadFlightNumbersAsync();
    }

    private async Task LoadFlightNumbersAsync()
    {
        number = null;
        flightNumbers = [];
        validationMessage = null;

        if (!HasSelectedRoute)
        {
            return;
        }

        isFlightNumbersLoading = true;
        try
        {
            flightNumbers = await FlightsClient.ListFlightNumbersAsync(
                originAirportId!.Value,
                destinationAirportId!.Value,
                departureDate,
                airlineId,
                airplaneId,
                CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            validationMessage = "No pudimos cargar los números de vuelo disponibles.";
        }
        finally
        {
            isFlightNumbersLoading = false;
        }
    }
}
