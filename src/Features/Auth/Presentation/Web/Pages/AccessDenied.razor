@page "/access-denied"

<PageTitle>Acceso denegado | Airport</PageTitle>

<section class="login-page" aria-labelledby="denied-title">
    <div class="login-card">
        <div class="login-card__intro">
            <span class="login-card__icon material-symbols-rounded" aria-hidden="true">block</span>
            <span class="eyebrow">Permisos</span>
            <h1 id="denied-title">Acceso denegado</h1>
            <p>Tu cuenta no tiene permisos para consultar esta sección.</p>
        </div>
        <a class="primary-button login-submit" href="/">Volver a vuelos</a>
    </div>
</section>
