@page "/login"
@using Airport.Features.Auth.Presentation.Web.Models
@using Airport.Features.Auth.Presentation.Web.Services
@inject AuthClient AuthClient
@inject AuthSession AuthSession

<PageTitle>Iniciar sesión | Airport</PageTitle>

<section class="login-page" aria-labelledby="login-title">
    <div class="login-card">
        <div class="login-card__intro">
            <span class="login-card__icon material-symbols-rounded" aria-hidden="true">shield_person</span>
            <span class="eyebrow">Acceso de usuarios</span>
            <h1 id="login-title">Bienvenido de vuelta</h1>
            <p>Ingresa con tus credenciales para consultar vuelos y gestionar tus compras.</p>
        </div>

        @if (AuthSession.IsAuthenticated)
        {
            <div class="login-success" role="status">
                <span class="material-symbols-rounded" aria-hidden="true">verified_user</span>
                <div>
                    <strong>Sesión iniciada como @AuthSession.Current!.Username</strong>
                    <p>@string.Join(" · ", AuthSession.Current.Roles)</p>
                </div>
            </div>
            <div class="login-actions">
                @if (AuthSession.IsAdmin)
                {
                    <a class="primary-button" href="/admin">Ir al panel administrativo</a>
                }
                else
                {
                    <a class="primary-button" href="/">Explorar vuelos</a>
                }
                @if (AuthSession.IsCookieSession)
                {
                    <a class="text-button" href="/account/security/mfa">Configurar MFA</a>
                }
                <button class="text-button" type="button" @onclick="SignOutAsync">Cerrar sesión</button>
            </div>
        }
        else
        {
            @if (requiresMfa)
            {
                <EditForm Model="mfa" OnValidSubmit="VerifyMfaAsync" FormName="password-mfa">
                    <div class="form-field">
                        <label for="mfa-code">Código del autenticador</label>
                        <div class="input-shell">
                            <span class="material-symbols-rounded" aria-hidden="true">password</span>
                            <InputText id="mfa-code" @bind-Value="mfa.Code" inputmode="numeric"
                                       autocomplete="one-time-code" maxlength="8" />
                        </div>
                    </div>
                    <button class="primary-button login-submit" type="submit">Verificar MFA</button>
                </EditForm>
            }
            else
            {
            <EditForm Model="credentials" OnValidSubmit="LoginAsync" FormName="employee-login">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="username">Usuario o correo</label>
                    <div class="input-shell">
                        <span class="material-symbols-rounded" aria-hidden="true">person</span>
                        <InputText id="username" @bind-Value="credentials.Username"
                                   autocomplete="username" disabled="@isLoading" />
                    </div>
                    <ValidationMessage For="() => credentials.Username" />
                </div>

                <div class="form-field">
                    <label for="password">Contraseña</label>
                    <div class="input-shell">
                        <span class="material-symbols-rounded" aria-hidden="true">lock</span>
                        <InputText id="password" type="password" @bind-Value="credentials.Password"
                                   autocomplete="current-password" disabled="@isLoading" />
                    </div>
                    <ValidationMessage For="() => credentials.Password" />
                </div>

                @if (errorMessage is not null)
                {
                    <div class="login-error" role="alert">
                        <span class="material-symbols-rounded" aria-hidden="true">error</span>
                        <span>@errorMessage</span>
                    </div>
                }

                <button class="primary-button login-submit" type="submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="material-symbols-rounded login-spinner" aria-hidden="true">progress_activity</span>
                        <span>Ingresando…</span>
                    }
                    else
                    {
                        <span>Iniciar sesión</span>
                        <span class="material-symbols-rounded" aria-hidden="true">login</span>
                    }
                </button>
            </EditForm>

            <p class="account-link">¿No tienes cuenta? <a href="/register">Regístrate</a></p>

            @if (googleAvailable)
            {
                <div class="login-divider"><span>o</span></div>
                <a class="google-button" href="@AuthClient.GoogleLoginUrl">
                    <span class="google-button__mark" aria-hidden="true">G</span>
                    <span>Continuar con Google</span>
                </a>
            }
            }
        }
    </div>

</section>

@code {
    private readonly LoginCredentials credentials = new();
    private readonly MfaCodeInput mfa = new();
    private bool isLoading;
    private bool googleAvailable;
    private bool requiresMfa;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            googleAvailable = (await AuthClient.GetProvidersAsync(CancellationToken.None)).Google;
            if (!AuthSession.IsAuthenticated)
            {
                var cookieSession = await AuthClient.GetSessionAsync(CancellationToken.None);
                if (cookieSession is not null)
                {
                    AuthSession.SignIn(cookieSession);
                }
            }
        }
        catch (HttpRequestException)
        {
            googleAvailable = false;
        }
    }

    private async Task LoginAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var attempt = await AuthClient.LoginAsync(credentials, CancellationToken.None);

            if (attempt.RequiresMfa)
            {
                requiresMfa = true;
                return;
            }

            if (attempt.Session is null)
            {
                errorMessage = "El usuario o la contraseña no son correctos.";
                return;
            }

            AuthSession.SignIn(attempt.Session);
        }
        catch (HttpRequestException)
        {
            errorMessage = "No pudimos conectar con el servicio de autenticación.";
        }
        catch (InvalidOperationException)
        {
            errorMessage = "La respuesta del servicio de autenticación no es válida.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (!await AuthClient.CompleteMfaSignInAsync(mfa.Code, CancellationToken.None))
        {
            errorMessage = "El código del autenticador no es válido.";
            return;
        }

        var session = await AuthClient.GetSessionAsync(CancellationToken.None);
        if (session is null)
        {
            errorMessage = "No fue posible recuperar la sesión.";
            return;
        }

        AuthSession.SignIn(session);
        requiresMfa = false;
    }

    private async Task SignOutAsync()
    {
        if (AuthSession.IsCookieSession)
        {
            await AuthClient.LogoutAsync(CancellationToken.None);
        }

        AuthSession.SignOut();
        credentials.Password = string.Empty;
    }
}
